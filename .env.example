# DagLock Indexer — Environment Configuration Example
# Copy this to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────

# Message encryption key (AES-256-GCM). REQUIRED — panics if not set.
# Generate with: openssl rand -hex 32
DAGLOCK_MESSAGE_KEY=

# Template hashes for UTXO detection on the target network.
# Generated by: cargo test -p daglock-contracts -- print_template_hashes --nocapture
DAGLOCK_KAS_TEMPLATE=3502219e8c85ff1f4eb3c1f20ff1049518302d2c
DAGLOCK_ARBITER_TEMPLATE=69440eb964bbf7cb508c1f403549f00e88e67af8
DAGLOCK_KRC20_TEMPLATE=da57b7b66dd2f9a35dcb83a7fea3c05d1300c28e
DAGLOCK_VAULT_TEMPLATE=23734973784f8d47adf0c0a43744955817258d1d
DAGLOCK_VAULT_SOFTLOCK_TEMPLATE=9777c9eb9e6271a32fac75d3533bc27d25b20d39
DAGLOCK_VAULT_MULTISIG_TEMPLATE=b0cddcd4dc716532fd86d1809a05f8ea7e74113d
DAGLOCK_REPUTATION_TEMPLATE=65c54102c64a331414b602760cbd76efac3d69df
DAGLOCK_SUBSCRIPTION_TEMPLATE=accde148ae0b399a6d7759f00004c45234fb0b1f

# ── Server ────────────────────────────────────────────────────────────

# Port for the REST API (default: 8543). Railway/Heroku inject PORT env var.
# PORT=8543

# Network (default: testnet-11). Set to "mainnet" for production.
# DAGLOCK_NETWORK=testnet-11

# Database type: "sqlite" or "postgres" (default: sqlite)
# DAGLOCK_DB_TYPE=sqlite

# Kaspa node wRPC URL (optional — runs Kaspa REST API verifier without it)
# DAGLOCK_WRPC_URL=ws://127.0.0.1:17110

# Kaspa community REST API URL for UTXO verification (default: mainnet API)
# For testnet-11: https://api-tn11.kaspa.org
# DAGLOCK_KASPA_API_URL=https://api.kaspa.org

# CORS origin (default: https://daglock.com). Use * for development.
# DAGLOCK_CORS_ORIGIN=https://daglock.com

# Explorer base URL for block explorer links (default: https://kas.fyi)
# EXPLORER_BASE_URL=https://kas.fyi

# Log level (default: info). Options: error, warn, info, debug, trace.
# RUST_LOG=info

# Output logs as JSON (for production log aggregation).
# DAGLOCK_LOG_JSON=false

# ── Authentication ────────────────────────────────────────────────────

# Admin auth token for privileged endpoints (tier management, moderation).
# When not set, admin endpoints return 403.
# DAGLOCK_ADMIN_TOKEN=

# Canonical treasury public key (64 hex chars). REQUIRED on mainnet.
# The compile API rejects requests with a different treasury key.
# DAGLOCK_TREASURY_PUBKEY=

# Mock authentication (any hex signature passes). NEVER use on mainnet.
# DAGLOCK_MOCK_AUTH=false

# Skip Ed25519 chat signature verification (dev mode only).
# DAGLOCK_MOCK_CHAT_SIG=false

# ── Email Notifications ───────────────────────────────────────────────

# SMTP configuration for email notifications (all required to enable).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-password
# NOTIFICATION_FROM=noreply@daglock.com

# ── AI Mediation ──────────────────────────────────────────────────────

# API key for AI mediation service. Uses gpt-4o by default.
# DAGLOCK_AI_MEDIATOR_API_KEY=
# DAGLOCK_AI_MEDIATOR_MODEL=gpt-4o

# ── Advanced ──────────────────────────────────────────────────────────

# Private key hex for broadcasting anchor txs. Without this, payloads
# are logged for manual broadcast. WARNING: keep this key secret.
# DAGLOCK_ANCHOR_WALLET_KEY=

# Interval between anchor batch flushes in seconds (default: 300).
# DAGLOCK_ANCHOR_INTERVAL_SECONDS=300

# Enable auto-sweep of expired vaults.
# DAGLOCK_AUTO_SWEEP_VAULTS=false

# Enable auto-settle of escrows after timeout.
# DAGLOCK_AUTO_SETTLE_ESCROWS=false

# Enable auto-escalate of unresolved disputes.
# DAGLOCK_AUTO_ESCALATE_DISPUTES=false

# Enable auto-sweep of stale deposits.
# DAGLOCK_AUTO_SWEEP_DEPOSITS=false

# Enable the background price alert checker.
# DAGLOCK_PRICE_ALERTS_ENABLED=false

# Hours after case resolution to auto-wipe revealed chat evidence (default: 24).
# DAGLOCK_EVIDENCE_AUTO_WIPE_HOURS=24

# Interval between daily stats computation runs in seconds (default: 3600).
# DAGLOCK_STATS_INTERVAL_SECONDS=3600
