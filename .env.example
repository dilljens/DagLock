# DagLock Indexer — Environment Configuration Example
# Copy this to .env and fill in your values.
# Never commit .env to version control.

# Message encryption key (AES-256-GCM). Generate with:
#   openssl rand -hex 32
# If not set, a deterministic dev key is used (messages survive restarts
# but are NOT secure for production).
# DAGLOCK_MESSAGE_KEY=

# Template hashes for UTXO detection. Generated by:
#   cargo test -p daglock-contracts -- print_template_hashes --nocapture
DAGLOCK_KAS_TEMPLATE=3502219e8c85ff1f4eb3c1f20ff1049518302d2c
DAGLOCK_ARBITER_TEMPLATE=69440eb964bbf7cb508c1f403549f00e88e67af8
DAGLOCK_KRC20_TEMPLATE=da57b7b66dd2f9a35dcb83a7fea3c05d1300c28e
DAGLOCK_VAULT_TEMPLATE=23734973784f8d47adf0c0a43744955817258d1d
DAGLOCK_VAULT_SOFTLOCK_TEMPLATE=9777c9eb9e6271a32fac75d3533bc27d25b20d39
DAGLOCK_VAULT_MULTISIG_TEMPLATE=b0cddcd4dc716532fd86d1809a05f8ea7e74113d
DAGLOCK_REPUTATION_TEMPLATE=65c54102c64a331414b602760cbd76efac3d69df
DAGLOCK_SUBSCRIPTION_TEMPLATE=accde148ae0b399a6d7759f00004c45234fb0b1f

# Database type: sqlite or postgres (default: sqlite)
# DAGLOCK_DB_TYPE=sqlite

# Kaspa node wRPC URL (optional, runs in offline mode without it)
# DAGLOCK_WRPC_URL=ws://127.0.0.1:17110

# Network (default: testnet-12)
# DAGLOCK_NETWORK=mainnet

# Log level (default: info)
# RUST_LOG=info
