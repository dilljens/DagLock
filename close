#!/bin/bash
# DagLock Development Script — Close services
# Usage: ./close

set -euo pipefail

PIDFILE="/tmp/daglock-dev.pid"

echo "=== Stopping DagLock Development Environment ==="

if [ -f "$PIDFILE" ]; then
	echo "Stopping services (PID file)..."
	while read -r pid; do
		if kill "$pid" 2>/dev/null; then
			echo "  ✓ Stopped PID $pid"
		else
			echo "  - PID $pid not running"
		fi
	done < "$PIDFILE"
	rm -f "$PIDFILE"
else
	echo "No PID file found — stopping by process name..."
fi

# Cleanup any orphans
pkill -f "daglock-indexer.*8543" 2>/dev/null && echo "✓ Orphaned indexer stopped" || true
pkill -f "vite.*5173" 2>/dev/null && echo "✓ Orphaned web UI stopped" || true

echo ""
echo "=== All services stopped ==="
