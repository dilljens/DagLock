pragma silverscript ^0.1.0;

// DagLock Arbiter — Trustless escrow with optional mediator
//
// Seven spending paths:
//   release(buyerSig, sellerSig)                    — both parties sign to settle
//   swap(secret)                                     — hash preimage reveals for atomic swap
//   refundAfterTimeout(arbiterSig, buyerSig)          — mediator must co-sign timeout refund
//   disputeSellerWins(arbiterSig, sellerSig, fee)    — mediator + seller, seller gets paid
//   disputeBuyerWins(arbiterSig, buyerSig, fee)      — mediator + buyer, buyer gets refund
//   arbitrateSplit(arbiterSig, buyerShareBasis)      — mediator splits funds proportionally
//   emergencyRefund(buyerSig)                        — buyer reclaims after timeout + 30 days
//
// Fee model: 0.5% (1/200) on release, swap, split, and dispute paths.
// On release/swap/split, output[1] = treasury. On disputes, output[1] = treasury
// and output[2] = mediator fee (set per-dispute as entrypoint argument).
// On timeout refund and emergency refund, no fee.
//
// If arbiterKey is all-zeroes, dispute/split paths are unreachable (cannot
// forge the mediator's signature).
//
// Dust floor: all output values must be >= MIN_OUT (1000 sompi) unless
// explicitly zero (mediator fee may be waived).

contract DagLockArbiter(
    byte[32] buyerKey,
    byte[32] sellerKey,
    byte[32] tradeHash,       // SHA-256 of atomic-swap secret (zeroes if unused)
    int timeout,               // Unix timestamp after which refund is allowed
    byte[32] treasuryKey,      // DagLock fee treasury public key
    byte[32] arbiterKey        // Mediator public key (zeroes = dispute paths unreachable)
) {
    int constant MIN_OUT = 1000;

    // ── Path A: Mutual Release ──────────────────────────────────
    entrypoint function release(sig buyerSig, sig sellerSig) {
        require(checkSig(buyerSig, pubkey(buyerKey)));
        require(checkSig(sellerSig, pubkey(sellerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 200;
        int sendAmount = inputValue - feeAmount;

        require(sendAmount >= MIN_OUT);
        require(feeAmount >= MIN_OUT || feeAmount == 0);
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }

    // ── Path B: Atomic Swap ─────────────────────────────────────
    entrypoint function swap(byte[] secret) {
        require(sha256(secret) == tradeHash);

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 200;
        int sendAmount = inputValue - feeAmount;

        require(sendAmount >= MIN_OUT);
        require(feeAmount >= MIN_OUT || feeAmount == 0);
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }

    // ── Path C: Timeout Refund (mediator must co-sign) ────────────
    // Buyer cannot take funds alone after timeout. Mediator must
    // verify the dispute situation and sign. No fee — buyer gets
    // the full deposit back.
    entrypoint function refundAfterTimeout(sig arbiterSig, sig buyerSig) {
        require(tx.time >= timeout);
        require(checkSig(arbiterSig, pubkey(arbiterKey)));
        require(checkSig(buyerSig, pubkey(buyerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        require(inputValue >= MIN_OUT);
        require(tx.outputs[0].value == inputValue);
    }

    // ── Path D: Dispute — Seller Wins ──────────────────────────
    // Mediator and seller both sign. Seller receives deposit minus
    // treasury fee and mediator fee. Treasury and mediator each get
    // an output.
    entrypoint function disputeSellerWins(sig arbiterSig, sig sellerSig, int mediatorFee) {
        require(checkSig(arbiterSig, pubkey(arbiterKey)));
        require(checkSig(sellerSig, pubkey(sellerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 200;
        int sendAmount = inputValue - feeAmount - mediatorFee;
        require(sendAmount > 0);

        require(sendAmount >= MIN_OUT);
        require(feeAmount >= MIN_OUT || feeAmount == 0);
        require(mediatorFee >= MIN_OUT || mediatorFee == 0);
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));

        byte[34] mediatorScript = new ScriptPubKeyP2PK(pubkey(arbiterKey));
        require(tx.outputs[2].value == mediatorFee);
        require(tx.outputs[2].scriptPubKey == byte[](mediatorScript));
    }

    // ── Path E: Dispute — Buyer Wins ───────────────────────────
    // Mediator and buyer both sign. Buyer receives refund minus
    // treasury fee and mediator fee.
    entrypoint function disputeBuyerWins(sig arbiterSig, sig buyerSig, int mediatorFee) {
        require(checkSig(arbiterSig, pubkey(arbiterKey)));
        require(checkSig(buyerSig, pubkey(buyerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 200;
        int sendAmount = inputValue - feeAmount - mediatorFee;
        require(sendAmount > 0);

        require(sendAmount >= MIN_OUT);
        require(feeAmount >= MIN_OUT || feeAmount == 0);
        require(mediatorFee >= MIN_OUT || mediatorFee == 0);
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));

        byte[34] mediatorScript = new ScriptPubKeyP2PK(pubkey(arbiterKey));
        require(tx.outputs[2].value == mediatorFee);
        require(tx.outputs[2].scriptPubKey == byte[](mediatorScript));
    }

    // ── Path F: Arbitrate Split ─────────────────────────────────
    // Mediator rules a proportional split between buyer and seller.
    // buyerShareBasis is in basis points (0-10000). Three outputs:
    // [buyerAmount] [sellerAmount] [feeAmount → treasury].
    // No mediator fee — the split IS the mediation result.
    entrypoint function arbitrateSplit(sig arbiterSig, int buyerShareBasis) {
        require(checkSig(arbiterSig, pubkey(arbiterKey)));
        require(buyerShareBasis >= 0);
        require(buyerShareBasis <= 10000);

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 200;
        int distributable = inputValue - feeAmount;
        int buyerAmount = distributable * buyerShareBasis / 10000;
        int sellerAmount = distributable * (10000 - buyerShareBasis) / 10000;

        require(buyerAmount >= MIN_OUT);
        require(sellerAmount >= MIN_OUT);
        require(feeAmount >= MIN_OUT || feeAmount == 0);
        require(tx.outputs[0].value == buyerAmount);
        require(tx.outputs[1].value == sellerAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(tx.outputs[2].value == feeAmount);
        require(tx.outputs[2].scriptPubKey == byte[](treasuryScript));
    }

    // ── Path G: Emergency Refund ────────────────────────────────
    // Buyer can reclaim solo after timeout + 30 days.
    // No mediator signature needed. No fee.
    // This prevents funds from being stuck if the mediator disappears.
    entrypoint function emergencyRefund(sig buyerSig) {
        require(tx.time >= timeout + 2592000);  // timeout + 30 days
        require(checkSig(buyerSig, pubkey(buyerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        require(inputValue >= MIN_OUT);
        require(tx.outputs[0].value == inputValue);
    }
}
