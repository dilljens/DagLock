pragma silverscript ^0.1.0;

contract DagLockVault(
    byte[32] ownerKey,
    int timeout,
    byte[32] treasuryKey,
    byte[32] heirKey,
    int heirTimeout
) {
    int constant MIN_OUT = 1000;

    entrypoint function withdraw(sig ownerSig) {
        require(tx.time >= timeout);
        require(checkSig(ownerSig, pubkey(ownerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 1000;
        int sendAmount = inputValue - feeAmount;

        require(sendAmount >= MIN_OUT);
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(feeAmount >= MIN_OUT);
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }

    entrypoint function sweep() {
        require(tx.time >= timeout);

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 1000;
        int sendAmount = inputValue - feeAmount;

        require(sendAmount >= MIN_OUT);
        byte[34] ownerScript = new ScriptPubKeyP2PK(pubkey(ownerKey));
        require(tx.outputs[0].scriptPubKey == byte[](ownerScript));
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(feeAmount >= MIN_OUT);
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }

    entrypoint function relock(sig ownerSig, byte[34] newScript) {
        require(checkSig(ownerSig, pubkey(ownerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 1000;
        int sendAmount = inputValue - feeAmount;

        require(sendAmount >= MIN_OUT);
        require(tx.outputs[0].scriptPubKey == byte[](newScript));
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(feeAmount >= MIN_OUT);
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }

    entrypoint function early_exit(sig ownerSig) {
        require(checkSig(ownerSig, pubkey(ownerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 1000;
        int sendAmount = inputValue - feeAmount;

        require(sendAmount >= MIN_OUT);
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(feeAmount >= MIN_OUT);
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }

    entrypoint function heir_withdraw(sig heirSig) {
        require(tx.time >= heirTimeout);
        require(checkSig(heirSig, pubkey(heirKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 1000;
        int sendAmount = inputValue - feeAmount;

        require(sendAmount >= MIN_OUT);
        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        require(feeAmount >= MIN_OUT);
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }
}
