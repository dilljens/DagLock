pragma silverscript ^0.1.0;

// DagLock Vault — Time-locked KAS storage
//
// Two spending paths:
//   withdraw(sig ownerSig)     — owner reclaims after timeout
//
// No fee. No treasury. No counterparty. Pure self-custody time-lock.
// Constructor parameters use byte[32] (not pubkey) to work around
// the SilverScript compiler's strict type checking for constructor args.
// Casts to pubkey happen within the function bodies.

contract DagLockVault(
    byte[32] ownerKey,
    int timeout               // Unix timestamp before which withdrawal is blocked
) {
    // ── Path A: Timeout Withdraw ─────────────────────────────────
    entrypoint function withdraw(sig ownerSig) {
        require(tx.time >= timeout);
        require(checkSig(ownerSig, pubkey(ownerKey)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        require(tx.outputs[0].value == inputValue);
    }
}
