pragma silverscript ^0.1.0;

// DagLock Vault Multi-sig — N-of-M time-locked KAS storage
//
// Two spending paths:
//   withdraw(sig1, sig2, sig3)  — all configured keys must sign (N-of-N)
//   sweep(sig anyKey)            — any ONE configured key can sweep after lockDuration
//
// The sweep() path prevents fund lockup if any key is lost.
// Security note: sweep() gives a single key unilateral access
// after lockDuration. If a key is compromised, the timeout window is
// the protection. Use withdraw() for full security.
// 0.1% protocol fee (1/1000) sent to treasury on every withdrawal.

contract DagLockVaultMultisig(
    byte[32] key1,
    byte[32] key2,     // zero if unused
    byte[32] key3,     // zero if unused
    int lockDuration,  // DAA block count (~1 block/sec)
    byte[32] treasuryKey
) {
    int constant MIN_OUT = 1000;

    entrypoint function withdraw(sig sig1, sig sig2, sig sig3) {
        require(this.age >= lockDuration);
        require(checkSig(sig1, pubkey(key1)));

        if(key2 != byte[32](0)) {
            require(checkSig(sig2, pubkey(key2)));
        }

        if(key3 != byte[32](0)) {
            require(checkSig(sig3, pubkey(key3)));
        }

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 1000;
        int sendAmount = inputValue - feeAmount;

        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        // H2: Dust protection — only enforce treasury output when fee is meaningful
        require(feeAmount >= MIN_OUT || feeAmount == 0);
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }

    // ── Path B: Primary Key Sweep ───────────────────────────────
    // key1 can sweep alone after lockDuration. Other signers cannot block.
    // Prevents fund lockup if key2 or key3 disappear.
    // If key1 itself is lost, withdraw() still requires all keys.
    entrypoint function sweep(sig key1Sig) {
        require(this.age >= lockDuration);
        require(checkSig(key1Sig, pubkey(key1)));

        int inputValue = tx.inputs[this.activeInputIndex].value;
        int feeAmount = inputValue / 1000;
        int sendAmount = inputValue - feeAmount;

        require(tx.outputs[0].value == sendAmount);

        byte[34] treasuryScript = new ScriptPubKeyP2PK(pubkey(treasuryKey));
        // H2: Dust protection — only enforce treasury output when fee is meaningful
        require(feeAmount >= MIN_OUT || feeAmount == 0);
        require(tx.outputs[1].value == feeAmount);
        require(tx.outputs[1].scriptPubKey == byte[](treasuryScript));
    }
}
