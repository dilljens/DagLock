{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"a11y": {
				"useKeyWithClickEvents": {
					"level": "warn"
				},
				"noLabelWithoutControl": {
					"level": "warn"
				},
				"useButtonType": {
					"level": "warn"
				}
			},
			"suspicious": {
				"noArrayIndexKey": {
					"level": "warn"
				},
				"noExplicitAny": {
					"level": "warn"
				}
			},
			"style": {
				"noNonNullAssertion": {
					"level": "warn"
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	}
}
