{
	"name": "@daglock/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check src/",
		"test:e2e": "PLAYWRIGHT_CHROMIUM_HEADLESS_MODE=1 playwright test",
		"test:headed": "playwright test --headed",
		"test:ui": "playwright test --ui",
		"test:e2e:ci": "PLAYWRIGHT_CHROMIUM_HEADLESS_MODE=1 playwright test",
		"build:pay": "node build-pay.mjs",
		"format": "biome format --write src/",
		"seo": "bash ../scripts/seo-audit.sh",
		"links": "npx linkinator https://daglock.com --recurse"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@radix-ui/react-dialog": "^1.1.17",
		"@radix-ui/react-tabs": "^1.1.15",
		"@radix-ui/react-tooltip": "^1.2.10",
		"@tanstack/react-query": "^5.101.0",
		"motion": "^12.40.0",
		"react": "^18.3",
		"react-dom": "^18.3",
		"react-helmet-async": "^3.0.0",
		"react-hook-form": "^7.79.0",
		"tweetnacl": "^1.0.3",
		"tweetnacl-util": "^0.15.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9",
		"@playwright/test": "^1.61.0",
		"@testing-library/jest-dom": "^6.6",
		"@testing-library/react": "^16.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^18.3",
		"@types/react-dom": "^18.3",
		"@vitejs/plugin-react": "^4.3",
		"jsdom": "^25.0",
		"typescript": "^5.5",
		"vite": "^7.0.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^3.0"
	}
}
